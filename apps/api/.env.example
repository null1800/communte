# ComUnite API — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: https://supabase.com/dashboard/project/<your-project>/settings/api
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key — keep this secret>

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must match the JWT secret under Supabase Settings > API > JWT Secret
JWT_SECRET=<your-supabase-jwt-secret>

# ── Auth ──────────────────────────────────────────────────────────────────────
# Set to "true" only in local development to enable POST /auth/development-token
AUTH_DEV_MODE=false

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
