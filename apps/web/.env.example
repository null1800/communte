# ComUnite Web — Environment Variables
# Copy to .env.local and fill in your values. Never commit .env.local.

# ── Supabase (public/anon — safe to expose in browser) ───────────────────────
# From: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# ── Internal API ──────────────────────────────────────────────────────────────
# URL the Next.js app uses to reach the NestJS API
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
